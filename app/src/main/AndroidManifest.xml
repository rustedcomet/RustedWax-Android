<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<!-- Talking to Hive nodes: validating a key, and broadcasting scrobbles. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!--
		Picture-in-picture measurement. A PiP Short publishes no progress at all,
		so the only way to credit it is to observe that YouTube still holds a
		visible window while media audio is playing. Usage Access is what makes
		that attributable to YouTube rather than to "some app" — AudioManager
		alone hands out anonymized playback configurations with no package on
		them. Special access, granted by the user in Settings; the app works
		without it and simply does not count PiP.
	-->
	<uses-permission
		android:name="android.permission.PACKAGE_USAGE_STATS"
		tools:ignore="ProtectedPermissions" />

	<!-- Lets us resolve app labels for the packages publishing media sessions. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.MAIN" />
		</intent>
	</queries>

	<application
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.RustedWax">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:label="@string/app_name">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!--
			v0.9.6: the watch-history sign-in. Not exported — it can only be
			started from inside RustedWax, so nothing else can put a Google
			sign-in page on screen wearing this app's name.
		-->
		<activity
			android:name=".ui.YouTubeSignInActivity"
			android:exported="false" />

		<!--
			Stub listener. It exists so the OS has a component to grant
			Notification Access to; getActiveSessions(ComponentName) then
			accepts that component from anywhere in the process.
			Real notification handling is never needed.
		-->
		<service
			android:name=".detect.RustedWaxListenerService"
			android:exported="false"
			android:label="@string/app_name"
			android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
			<intent-filter>
				<action android:name="android.service.notification.NotificationListenerService" />
			</intent-filter>
		</service>

		<!--
			Optional browser-evidence watcher. Off unless the user
			enables it in Accessibility settings. Reads the URL bar plus exact
			visible YouTube Shorts ad labels, and is scoped to browser packages
			in accessibility_service_config.xml, which the OS enforces.
		-->
		<service
			android:name=".detect.UrlWatcherService"
			android:exported="false"
			android:label="@string/browser_evidence_service_name"
			android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
			<intent-filter>
				<action android:name="android.accessibilityservice.AccessibilityService" />
			</intent-filter>
			<meta-data
				android:name="android.accessibilityservice"
				android:resource="@xml/accessibility_service_config" />
		</service>

		<!--
			v0.9.1: independent foreground native-Short observer. Its separate XML
			config lets Android enforce that this component can receive events only
			from com.google.android.youtube; the browser grant is not broadened.
		-->
		<service
			android:name=".detect.NativeShortsAccessibilityService"
			android:exported="false"
			android:label="@string/native_shorts_service_name"
			android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
			<intent-filter>
				<action android:name="android.accessibilityservice.AccessibilityService" />
			</intent-filter>
			<meta-data
				android:name="android.accessibilityservice"
				android:resource="@xml/native_shorts_accessibility_service_config" />
		</service>

		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>

	</application>

</manifest>
